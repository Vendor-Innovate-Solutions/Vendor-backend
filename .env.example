# Django Settings
SECRET_KEY=your-secret-key-here
DEBUG=False
ALLOWED_HOSTS=.railway.app,localhost,127.0.0.1

# Database (Railway provides this automatically)
DATABASE_URL=postgresql://user:password@host:port/database

# Superuser Configuration (optional - defaults: admin/admin@vendor.com/admin123)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@vendor.com
DJANGO_SUPERUSER_PASSWORD=admin123

# CORS Settings
CORS_ALLOWED_ORIGINS=https://your-frontend.railway.app,http://localhost:3000

# CSRF Settings
CSRF_TRUSTED_ORIGINS=https://your-backend.railway.app,https://your-frontend.railway.app

# Email Configuration (Optional)
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-specific-password
